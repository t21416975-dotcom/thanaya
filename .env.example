# ==========================================
# منصة ثنايا - ملف متغيرات البيئة التجريبي
# Thanaya Platform - Environment Variables
# ==========================================

# 1. Supabase Credentials (Public)
# Web (Astro):
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
PUBLIC_STORAGE_BASE_URL=https://your-storage-endpoint.com

# Admin (Vite):
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_STORAGE_BASE_URL=https://your-storage-endpoint.com

# 2. Site Domains & URLs
PUBLIC_SITE_URL=https://thanaya.com
ADMIN_SITE_URL=https://admin.thanaya.com
