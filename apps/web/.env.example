# Web App (Astro) Environment Variables
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
PUBLIC_STORAGE_BASE_URL=https://your-storage-endpoint.com
PUBLIC_SITE_URL=https://thanaya.dpdns.org
# ★ تسجيل دخول الطالب (Google OAuth) — لا يحتاج متغيرات جديدة:
#   يقرأ supabase/ssr الجلسة من الكوكيز بنفس المفاتيح أعلاه.
#   يجب أن يكون PUBLIC_SITE_URL مسجّلًا في:
#   Supabase → Authentication → URL Configuration → Redirect URLs
#   بصيغة: <PUBLIC_SITE_URL>/auth/callback
#   راجع STUDENT_AUTH_SETUP.md
#
# ⚠️ لا تضف SUPABASE_SERVICE_ROLE_KEY هنا إطلاقًا.
#   دوال الطالب كلها SECURITY DEFINER على anon key + جلسة المستخدم.
# الدومين المسموح فقط لاستدعاء /api/push-send (قائمة CORS)
ADMIN_SITE_URL=http://localhost:5173
# Web Push (VAPID) — ولّد زوجًا جديدًا ولا تضع أي مفتاح حقيقي هنا
# node -e "console.log(require('web-push').generateVAPIDKeys())"
PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@thanaya.com
