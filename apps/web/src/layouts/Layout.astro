---
import { ClientRouter } from 'astro:transitions';
import AdSlot from '../components/AdSlot.astro';
import NavigationLoadingIndicator from '../components/NavigationLoadingIndicator.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: string;
  ogImage?: string;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title,
  description = 'منصة ثنايا - التقييمات الأسبوعية وحلولها وامتحانات الثانوية العامة والبكالوريا المصرية مجمعة ومنظمة في مكان واحد.',
  canonicalUrl,
  ogType = 'website',
  ogImage = '/og-image.png',
  jsonLd,
} = Astro.props;

const canonicalURL = canonicalUrl
  ? (canonicalUrl.startsWith('http') ? canonicalUrl : new URL(canonicalUrl, Astro.site).href)
  : new URL(Astro.url.pathname, Astro.site).href;

const socialImageURL = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, Astro.site).href;

const siteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'منصة ثنايا للبكالوريا المصرية',
  url: 'https://thanaya-web.vercel.app',
  description: 'المكتبة المنظمة الأولى لتقييمات وحلول ومذكرات الثانوية العامة والبكالوريا المصرية.',
  inLanguage: 'ar-EG',
};
---

<!doctype html>
<html lang="ar" dir="rtl" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#059669" />
    <meta name="color-scheme" content="light" />

    <!-- Favicon and App Icons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <!-- Astro ClientRouter for instant SPA navigations & transitions -->
    <ClientRouter />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="google-site-verification" content="2V3HvcXiOFtClje7g_ZbVT_f9DvtpVPkJZ1KL8yECuU" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="منصة ثنايا للبكالوريا" />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:locale" content="ar_EG" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <!-- Performance font preconnects -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Global JSON-LD Schema -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(siteSchema)} />

    <!-- Page-Specific JSON-LD Schema (if provided) -->
    {
      jsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(Array.isArray(jsonLd) ? jsonLd : jsonLd)}
        />
      )
    }

    <style>
      body {
        font-family: 'Cairo', system-ui, -apple-system, sans-serif;
      }
    </style>
  </head>
  <body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col antialiased">
    <!-- Instant Visual Feedback: Progress Bar + Loading Spinner -->
    <NavigationLoadingIndicator />

    <!-- Navbar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-40">
      <div class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 text-xl font-extrabold text-slate-900 hover:text-emerald-700 transition">
          <span class="w-8 h-8 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-500 text-white flex items-center justify-center shadow-sm flex-shrink-0">
            <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
              <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
            </svg>
          </span>
          <span>ثنايا</span>
          <span class="text-xs bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full font-bold">
            البكالوريا المصرية
          </span>
        </a>

        <div class="flex items-center gap-4 text-xs font-semibold text-slate-600">
          <a href="/" class="hover:text-emerald-700 transition">الرئيسية</a>
        </div>
      </div>
    </header>

    <!-- Main Content Container -->
    <main class="flex-1 max-w-5xl mx-auto px-4 py-8 w-full">
      <slot />
    </main>

    <!-- Footer Ad Slot -->
    <div class="max-w-5xl mx-auto px-4 w-full">
      <AdSlot position="footer" />
    </div>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 mt-auto">
      <div class="max-w-5xl mx-auto px-4 py-8 sm:py-10">
        <div class="grid grid-cols-1 sm:grid-cols-12 gap-6 sm:gap-8 mb-8">
          <!-- Brand -->
          <div class="sm:col-span-6 space-y-2.5 text-center sm:text-right">
            <a href="/" class="inline-flex items-center gap-2 text-lg font-extrabold text-slate-900 hover:text-emerald-700 transition">
              <span class="w-8 h-8 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-500 text-white flex items-center justify-center flex-shrink-0 shadow-sm">
                <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                  <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                </svg>
              </span>
              <span>ثنايا</span>
            </a>
            <p class="text-xs text-slate-500 leading-relaxed max-w-sm mx-auto sm:mx-0">
              المكتبة التعليمية الأولى للثانوية العامة والبكالوريا المصرية — مجانًا وبأعلى سرعة.
            </p>
          </div>

          <!-- Links wrapper: 2 columns on mobile side by side -->
          <div class="sm:col-span-6 grid grid-cols-2 gap-6 text-right">
            <!-- Quick links -->
            <div>
              <p class="text-xs font-bold text-slate-800 uppercase tracking-wider mb-2.5">روابط سريعة</p>
              <ul class="space-y-2">
                <li><a href="/" class="inline-block text-xs sm:text-sm text-slate-500 hover:text-emerald-600 transition py-0.5">الرئيسية</a></li>
                <li><a href="/about" class="inline-block text-xs sm:text-sm text-slate-500 hover:text-emerald-600 transition py-0.5">من نحن</a></li>
                <li><a href="/contact" class="inline-block text-xs sm:text-sm text-slate-500 hover:text-emerald-600 transition py-0.5">اتصل بنا</a></li>
              </ul>
            </div>

            <!-- Legal -->
            <div>
              <p class="text-xs font-bold text-slate-800 uppercase tracking-wider mb-2.5">قانوني</p>
              <ul class="space-y-2">
                <li><a href="/privacy" class="inline-block text-xs sm:text-sm text-slate-500 hover:text-emerald-600 transition py-0.5">سياسة الخصوصية</a></li>
                <li><a href="/terms" class="inline-block text-xs sm:text-sm text-slate-500 hover:text-emerald-600 transition py-0.5">الشروط والأحكام</a></li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Copyright & Credits -->
        <div class="border-t border-slate-100 pt-6 flex flex-col sm:flex-row items-center justify-between gap-2 text-[11px] text-slate-400 text-center sm:text-right">
          <p>© 2026 منصة ثنايا التعليمية. جميع الحقوق محفوظة.</p>
          <p>جميع حقوق المواد محفوظة لوزارة التربية والتعليم المصرية ومعديها.</p>
        </div>
      </div>
    </footer>
  </body>
</html>

