---
import { ClientRouter } from 'astro:transitions';
import AdSlot from '../components/AdSlot.astro';
import NavigationLoadingIndicator from '../components/NavigationLoadingIndicator.astro';
import AnnouncementBanner from '../components/AnnouncementBanner.astro';
import NotificationBell from '../components/NotificationBell.astro';
import { publicApi } from '../lib/api';
import { PLATFORM_NAME, buildOrganizationSchema, buildWebSiteSchema } from '../lib/geo';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: string;
  ogImage?: string;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title,
  description = 'منصة ثنايا - منصة تعليمية مصرية مخصصة حاليًا لطلاب تانية بكالوريا، تجمع التقييمات الأسبوعية وحلولها والامتحانات والملخصات والكتب في مكان واحد.',
  canonicalUrl,
  ogType = 'website',
  ogImage = '/og-image.png',
  jsonLd,
} = Astro.props;

const canonicalURL = canonicalUrl
  ? (canonicalUrl.startsWith('http') ? canonicalUrl : new URL(canonicalUrl, Astro.site).href)
  : new URL(Astro.url.pathname, Astro.site).href;

const socialImageURL = ogImage.startsWith('http')
  ? ogImage
  : new URL(ogImage, Astro.site).href;

const siteSchema = buildWebSiteSchema();
const organizationSchema = buildOrganizationSchema();

const notifications = await publicApi.getActiveNotifications();

// Primary navigation with active-state detection
const currentPath = Astro.url.pathname;
const navLinks = [
  { href: '/', label: 'الرئيسية', isActive: currentPath === '/' },
  { href: '/#subjects', label: 'المواد الدراسية', isActive: currentPath.startsWith('/subjects') },
  { href: '/exams', label: 'الامتحانات التفاعلية', isActive: currentPath.startsWith('/exams') },
];
---

<!doctype html>
<html lang="ar" dir="rtl" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#059669" />
    <meta name="color-scheme" content="light" />

    <!-- Favicon and App Icons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <!-- Astro ClientRouter for instant SPA navigations & transitions -->
    <ClientRouter />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="google-site-verification" content="2V3HvcXiOFtClje7g_ZbVT_f9DvtpVPkJZ1KL8yECuU" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={PLATFORM_NAME} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:locale" content="ar_EG" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <!-- Performance font preconnects -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Global JSON-LD Schema (Organization identity + WebSite) -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify([organizationSchema, siteSchema])}
    />

    <!-- Page-Specific JSON-LD Schema (if provided) -->
    {
      jsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }

  </head>
  <body class="bg-slate-50 text-slate-900 min-h-screen flex flex-col antialiased font-arabic">
    <!-- Skip link for keyboard & screen-reader users -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:right-2 focus:z-[100] focus:inline-block focus:bg-emerald-700 focus:text-white focus:px-4 focus:py-2 focus:rounded-xl focus:text-sm focus:font-bold focus:shadow-lg"
    >
      تخطَّ إلى المحتوى الرئيسي
    </a>
    <!-- Instant Visual Feedback: Progress Bar + Loading Spinner -->
    <NavigationLoadingIndicator />

    <!-- Top Announcement Banner -->
    <AnnouncementBanner notifications={notifications} />

    <!-- Navbar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-40">
      <div class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between gap-3">
        <a href="/" class="flex items-center gap-2 text-xl font-bold text-slate-900 hover:text-emerald-700 transition rounded-xl">
          <span class="w-8 h-8 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-500 text-white flex items-center justify-center shadow-sm flex-shrink-0">
            <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
              <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
            </svg>
          </span>
          <span>ثنايا</span>
          <span class="hidden sm:inline-flex text-xs bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full font-bold">
            البكالوريا المصرية
          </span>
        </a>

        <!-- Desktop navigation -->
        <nav aria-label="التنقل الرئيسي" class="hidden sm:flex items-center gap-1">
          {navLinks.map((link) => (
            <a
              href={link.href}
              aria-current={link.isActive ? 'page' : undefined}
              class:list={[
                'px-3 py-2 rounded-xl text-sm font-semibold transition',
                link.isActive
                  ? 'text-emerald-700 bg-emerald-50'
                  : 'text-slate-600 hover:text-emerald-700 hover:bg-slate-100',
              ]}
            >
              {link.label}
            </a>
          ))}
        </nav>

        <div class="flex items-center gap-1.5">
          <NotificationBell notifications={notifications} />

          <!-- Mobile menu trigger -->
          <button
            type="button"
            id="mobile-nav-btn"
            aria-expanded="false"
            aria-controls="mobile-nav-panel"
            aria-label="فتح قائمة التنقل"
            class="sm:hidden p-2 text-slate-600 hover:text-emerald-700 hover:bg-slate-100 rounded-xl transition cursor-pointer"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="4" y1="7" x2="20" y2="7"></line>
              <line x1="4" y1="12" x2="20" y2="12"></line>
              <line x1="4" y1="17" x2="20" y2="17"></line>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile navigation panel -->
      <nav
        id="mobile-nav-panel"
        aria-label="قائمة التنقل للجوال"
        class="hidden sm:hidden border-t border-slate-100 bg-white"
      >
        <div class="max-w-5xl mx-auto px-4 py-2 flex flex-col">
          {navLinks.map((link) => (
            <a
              href={link.href}
              aria-current={link.isActive ? 'page' : undefined}
              class:list={[
                'px-3 py-3 rounded-xl text-sm font-semibold transition',
                link.isActive
                  ? 'text-emerald-700 bg-emerald-50'
                  : 'text-slate-700 hover:text-emerald-700 hover:bg-slate-50',
              ]}
            >
              {link.label}
            </a>
          ))}
        </div>
      </nav>
    </header>

    <!-- Main Content Container -->
    <main id="main-content" class="flex-1 max-w-5xl mx-auto px-4 py-8 w-full">
      <slot />
    </main>

    <!-- Footer Ad Slot -->
    <div class="max-w-5xl mx-auto px-4 w-full">
      <AdSlot position="footer" />
    </div>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 mt-auto">
      <div class="max-w-5xl mx-auto px-4 py-8 sm:py-10">
        <div class="grid grid-cols-1 sm:grid-cols-12 gap-6 sm:gap-8 mb-8">
          <!-- Brand -->
          <div class="sm:col-span-6 space-y-2.5 text-center sm:text-right">
            <a href="/" class="inline-flex items-center gap-2 text-lg font-bold text-slate-900 hover:text-emerald-700 transition rounded-xl">
              <span class="w-8 h-8 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-500 text-white flex items-center justify-center flex-shrink-0 shadow-sm">
                <svg class="w-4 h-4 fill-none stroke-current stroke-2" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                  <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                </svg>
              </span>
              <span>ثنايا</span>
            </a>
            <p class="text-xs text-slate-500 leading-relaxed max-w-sm mx-auto sm:mx-0">
              المكتبة التعليمية الأولى لطلاب تانية بكالوريا — مجانًا وبأعلى سرعة.
            </p>
          </div>

          <!-- Links wrapper: 2 columns on mobile side by side -->
          <div class="sm:col-span-6 grid grid-cols-2 gap-6 text-right">
            <!-- Quick links -->
            <div>
              <p class="text-xs font-bold text-slate-800 mb-2.5">روابط سريعة</p>
              <ul class="space-y-2">
                <li><a href="/" class="inline-block text-xs sm:text-sm text-slate-500 hover:text-emerald-600 transition py-0.5">الرئيسية</a></li>
                <li><a href="/about" class="inline-block text-xs sm:text-sm text-slate-500 hover:text-emerald-600 transition py-0.5">من نحن</a></li>
                <li><a href="/contact" class="inline-block text-xs sm:text-sm text-slate-500 hover:text-emerald-600 transition py-0.5">اتصل بنا</a></li>
              </ul>
            </div>

            <!-- Legal -->
            <div>
              <p class="text-xs font-bold text-slate-800 mb-2.5">قانوني</p>
              <ul class="space-y-2">
                <li><a href="/privacy" class="inline-block text-xs sm:text-sm text-slate-500 hover:text-emerald-600 transition py-0.5">سياسة الخصوصية</a></li>
                <li><a href="/terms" class="inline-block text-xs sm:text-sm text-slate-500 hover:text-emerald-600 transition py-0.5">الشروط والأحكام</a></li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Copyright & Credits -->
        <div class="border-t border-slate-100 pt-6 flex flex-col sm:flex-row items-center justify-between gap-2 text-[11px] text-slate-500 text-center sm:text-right">
          <p>© 2026 منصة ثنايا التعليمية. جميع الحقوق محفوظة.</p>
          <p>جميع حقوق المواد محفوظة لوزارة التربية والتعليم المصرية ومعديها.</p>
        </div>
      </div>
    </footer>

    <!-- Mobile Navigation Toggle -->
    <script>
      function initMobileNav() {
        const btn = document.getElementById('mobile-nav-btn');
        const panel = document.getElementById('mobile-nav-panel');
        if (!btn || !panel || btn.dataset.bound === 'true') return;
        btn.dataset.bound = 'true';

        btn.addEventListener('click', () => {
          const willOpen = panel.classList.contains('hidden');
          panel.classList.toggle('hidden', !willOpen);
          btn.setAttribute('aria-expanded', String(willOpen));
          btn.setAttribute('aria-label', willOpen ? 'إغلاق قائمة التنقل' : 'فتح قائمة التنقل');
        });

        panel.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            panel.classList.add('hidden');
            btn.setAttribute('aria-expanded', 'false');
          });
        });
      }

      initMobileNav();
      document.addEventListener('astro:page-load', initMobileNav);
    </script>

    <!-- Service Worker Registration for Web Push -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function (err) {
            console.error('[SW] Registration failed:', err);
          });
        });
      }
    </script>
  </body>
</html>

