---
import type { Subject } from '@thanaya/types';

interface Props {
  subject: Subject;
}

const { subject } = Astro.props;
---

<a
  href={`/subjects/${subject.slug}`}
  class="group block bg-white rounded-2xl border border-slate-200 p-5 hover:border-emerald-500 hover:shadow-md transition duration-150"
>
  <div class="flex items-start justify-between">
    <div class="space-y-1.5">
      <h3 class="font-bold text-slate-900 group-hover:text-emerald-700 transition text-base">
        {subject.name}
      </h3>
      {subject.description && (
        <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">
          {subject.description}
        </p>
      )}
    </div>
    <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center shrink-0 group-hover:bg-emerald-600 group-hover:text-white transition">
      <span class="text-sm font-bold">←</span>
    </div>
  </div>
</a>
