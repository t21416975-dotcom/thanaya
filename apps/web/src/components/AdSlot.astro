---
import type { AdSlotPosition } from '@thanaya/types';
import { publicApi } from '../lib/api';

interface Props {
  position: AdSlotPosition;
}

const { position } = Astro.props;
const slot = await publicApi.getAdSlot(position);
const directAd = slot?.slot_type === 'direct' ? await publicApi.getActiveDirectAdForSlot(position) : null;

// Dynamic unique ID for each slot instance
const dynamicSuffix = Math.random().toString(36).substring(2, 9);
const dynamicContainerId = `container-${dynamicSuffix}`;
const instanceId = `ad-slot-${position}-${dynamicSuffix}`;
---

{
  slot && slot.is_active && (
    <aside
      id={instanceId}
      aria-label="مساحة إعلانية"
      class="w-full my-4 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm flex flex-col justify-between"
      data-ad-position={position}
    >
      <!-- Disclosing Header -->
      <div class="flex items-center justify-between px-4 py-1.5 bg-slate-50 border-b border-slate-100 text-[10px] text-slate-400 font-medium select-none">
        <span>إعلان معتمد</span>
        <span>مساحة إعلانية</span>
      </div>

      <!-- Direct Ad Rendering -->
      {slot.slot_type === 'direct' && directAd ? (
        <a
          href={directAd.target_url}
          target="_blank"
          rel="noopener sponsored"
          class="block p-4 group text-center hover:bg-slate-50 transition"
          data-direct-ad-id={directAd.id}
        >
          {directAd.image_url && (
            <img
              src={directAd.image_url}
              alt={directAd.title}
              loading="lazy"
              class="max-h-24 w-auto mx-auto rounded-lg object-contain"
            />
          )}
          <div class="mt-2">
            <h4 class="text-xs sm:text-sm font-bold text-slate-900 group-hover:text-emerald-700 transition">
              {directAd.title}
            </h4>
            <span class="text-[10px] text-slate-400 mt-0.5 inline-block">
              بواسطة: {directAd.advertiser_name}
            </span>
          </div>
        </a>
      ) : slot.slot_type === 'google' ? (
        <!-- Adsterra 1:1 Height-based Clipped Container (Centered & 1:1 Layout) -->
        <div class="w-full min-h-[250px] max-h-[300px] h-[280px] flex justify-center items-center overflow-hidden bg-slate-50/20">
          <iframe
            id={`frame-${dynamicContainerId}`}
            srcdoc={`<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <base target="_blank">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    html, body {
      width: 100%;
      height: 100%;
      min-height: 280px;
      background: transparent;
      display: flex !important;
      flex-direction: column !important;
      justify-content: center !important;
      align-items: center !important;
      overflow: hidden !important;
      scrollbar-width: none !important;
      font-family: system-ui, -apple-system, sans-serif;
    }
    html::-webkit-scrollbar, body::-webkit-scrollbar {
      display: none !important;
    }
    #container-ccae9d506cf77407ce62d684b21d33c5 {
      width: 100%;
      max-width: 100%;
      margin: 0 auto !important;
      padding: 0 !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: center !important;
      align-items: center !important;
      overflow: hidden !important;
    }
    img, picture, svg, video {
      max-width: 100% !important;
      max-height: 150px !important;
      object-fit: cover !important;
      border-radius: 8px !important;
      display: block;
      margin: 0 auto !important;
    }
    a {
      text-decoration: none;
      color: inherit;
      display: block;
      margin: 0 auto !important;
      text-align: center;
    }
  </style>
</head>
<body>
  <script async="async" data-cfasync="false" src="https://pl31266860.profitableratecpmnetwork.com/ccae9d506cf77407ce62d684b21d33c5/invoke.js"></script>
  <div id="container-ccae9d506cf77407ce62d684b21d33c5"></div>
</body>
</html>`}
            class="w-full h-[280px] max-h-[300px] border-0 overflow-hidden block mx-auto"
            loading="lazy"
            title={`إعلان ${position}`}
          ></iframe>
        </div>
      ) : (
        <!-- Platform Support Fallback Message -->
        <div class="p-5 text-center flex flex-col items-center justify-center space-y-1">
          <p class="text-xs sm:text-sm font-semibold text-slate-800">
            منصة ثنايا مجانية لجميع طلاب مصر ❤️
          </p>
          <p class="text-[11px] text-slate-500">
            الإعلانات تساعدنا في دفع تكاليف الاستضافة وتوفير كافة المذكرات والتقييمات للجميع.
          </p>
        </div>
      )}
    </aside>
  )
}

<script>
  import { supabase } from '../lib/supabase';

  function initAdTracking() {
    const isLive =
      !!import.meta.env.PUBLIC_SUPABASE_URL &&
      import.meta.env.PUBLIC_SUPABASE_URL !== 'https://your-project.supabase.co';

    // Direct Ad Impression & Click Tracking
    document.querySelectorAll('[data-direct-ad-id]').forEach((adEl) => {
      const adId = adEl.getAttribute('data-direct-ad-id');
      if (!adId) return;

      // Track Impression once per session
      const impKey = `thanaya_ad_imp_${adId}`;
      if (typeof window !== 'undefined' && !sessionStorage.getItem(impKey)) {
        sessionStorage.setItem(impKey, '1');
        if (isLive) {
          (supabase.rpc as any)('increment_ad_impressions', { p_ad_id: adId }).catch(() => {});
        }
      }

      // Track Click
      adEl.addEventListener('click', () => {
        if (isLive) {
          (supabase.rpc as any)('increment_ad_clicks', { p_ad_id: adId }).catch(() => {});
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initAdTracking);
</script>



