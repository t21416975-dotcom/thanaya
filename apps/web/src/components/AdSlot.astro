---
import type { AdSlotPosition } from '@thanaya/types';
import { publicApi } from '../lib/api';

interface Props {
  position: AdSlotPosition;
}

const { position } = Astro.props;
const slot = await publicApi.getAdSlot(position);
const directAd = slot?.slot_type === 'direct' ? await publicApi.getActiveDirectAdForSlot(position) : null;

// Dynamic unique ID for each slot instance
const dynamicSuffix = Math.random().toString(36).substring(2, 9);
const dynamicContainerId = `container-${dynamicSuffix}`;
const instanceId = `ad-slot-${position}-${dynamicSuffix}`;
---

{
  slot && slot.is_active && (
    <aside
      id={instanceId}
      aria-label="مساحة إعلانية"
      class="w-full my-4 rounded-2xl border border-slate-200 bg-white shadow-sm flex flex-col justify-between"
      data-ad-position={position}
    >
      <!-- Disclosing Header -->
      <div class="flex items-center justify-between px-4 py-1.5 bg-slate-50 border-b border-slate-100 text-[10px] text-slate-400 font-medium select-none">
        <span>إعلان معتمد</span>
        <span>مساحة إعلانية</span>
      </div>

      <!-- Direct Ad Rendering -->
      {slot.slot_type === 'direct' && directAd ? (
        <a
          href={directAd.target_url}
          target="_blank"
          rel="noopener sponsored"
          class="block p-4 group text-center hover:bg-slate-50 transition"
          data-direct-ad-id={directAd.id}
        >
          {directAd.image_url && (
            <img
              src={directAd.image_url}
              alt={directAd.title}
              loading="lazy"
              class="max-h-24 w-auto mx-auto rounded-lg object-contain"
            />
          )}
          <div class="mt-2">
            <h4 class="text-xs sm:text-sm font-bold text-slate-900 group-hover:text-emerald-700 transition">
              {directAd.title}
            </h4>
            <span class="text-[10px] text-slate-400 mt-0.5 inline-block">
              بواسطة: {directAd.advertiser_name}
            </span>
          </div>
        </a>
      ) : slot.slot_type === 'google' ? (
        <!-- Adsterra 1:1 Native Banner Container (Auto-resizing & Centered) -->
        <div class="w-full flex justify-center items-center p-2 sm:p-3 overflow-x-hidden">
          <iframe
            id={`frame-${dynamicContainerId}`}
            srcdoc={`<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <base target="_blank">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    html, body {
      width: 100%;
      height: auto;
      min-height: 100%;
      background: transparent;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      overflow-x: hidden !important;
      overflow-y: visible !important;
      font-family: system-ui, -apple-system, sans-serif;
    }
    #container-ccae9d506cf77407ce62d684b21d33c5 {
      width: 100%;
      max-width: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      margin: 0 auto !important;
      overflow-x: hidden !important;
    }
    #container-ccae9d506cf77407ce62d684b21d33c5 > *,
    .item, .ad-item {
      margin: 0 auto !important;
      max-width: 100% !important;
      width: 100% !important;
      text-align: center !important;
    }
    img, picture, svg, video {
      max-width: 100% !important;
      height: auto !important;
      object-fit: contain !important;
      display: block;
      margin: 0 auto !important;
    }
    a {
      text-decoration: none;
      color: inherit;
      display: block;
      max-width: 100% !important;
      word-break: break-word;
      overflow-wrap: break-word;
    }
  </style>
</head>
<body>
  <div id="container-ccae9d506cf77407ce62d684b21d33c5"></div>
  <script async="async" data-cfasync="false" src="https://pl31266860.profitableratecpmnetwork.com/ccae9d506cf77407ce62d684b21d33c5/invoke.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/iframe-resizer@4.3.9/js/iframeResizer.contentWindow.min.js"></script>
  <script>
    function sendHeight() {
      var container = document.getElementById('container-ccae9d506cf77407ce62d684b21d33c5');
      var h = Math.max(
        document.body.scrollHeight,
        document.documentElement.scrollHeight,
        container ? container.offsetHeight : 0
      );
      if (h > 40) {
        window.parent.postMessage({
          type: 'thanaya-ad-resize',
          frameId: 'frame-${dynamicContainerId}',
          height: h
        }, '*');
      }
    }
    window.addEventListener('load', sendHeight);
    window.addEventListener('resize', sendHeight);
    if ('ResizeObserver' in window) {
      new ResizeObserver(sendHeight).observe(document.body);
    }
    if ('MutationObserver' in window) {
      new MutationObserver(sendHeight).observe(document.body, { childList: true, subtree: true, attributes: true });
    }
    setTimeout(sendHeight, 300);
    setTimeout(sendHeight, 800);
    setTimeout(sendHeight, 1500);
    setTimeout(sendHeight, 3000);
    setTimeout(sendHeight, 5000);
  </script>
</body>
</html>`}
            class="w-full border-0 block mx-auto transition-[height] duration-200"
            style="min-height: 140px; height: 260px; overflow-x: hidden;"
            loading="lazy"
            title={`إعلان ${position}`}
          ></iframe>
        </div>
      ) : (
        <!-- Platform Support Fallback Message -->
        <div class="p-5 text-center flex flex-col items-center justify-center space-y-1">
          <p class="text-xs sm:text-sm font-semibold text-slate-800">
            منصة ثنايا مجانية لجميع طلاب مصر ❤️
          </p>
          <p class="text-[11px] text-slate-500">
            الإعلانات تساعدنا في دفع تكاليف الاستضافة وتوفير كافة المذكرات والتقييمات للجميع.
          </p>
        </div>
      )}
    </aside>
  )
}

<script>
  import { supabase } from '../lib/supabase';

  // Dynamic iframe auto-resize handler
  function handleAdResize(e: MessageEvent) {
    if (e.data && e.data.type === 'thanaya-ad-resize' && e.data.frameId && typeof e.data.height === 'number') {
      const frame = document.getElementById(e.data.frameId) as HTMLIFrameElement | null;
      if (frame && e.data.height > 40) {
        frame.style.height = `${e.data.height + 10}px`;
      }
    }
    // iframe-resizer protocol support
    if (typeof e.data === 'string' && e.data.indexOf('[iFrameSizer]') === 0) {
      const parts = e.data.split(':');
      if (parts.length >= 2) {
        const h = parseInt(parts[1], 10);
        if (!isNaN(h) && h > 40) {
          const allFrames = document.querySelectorAll('iframe[id^="frame-container-"]');
          allFrames.forEach((f) => {
            (f as HTMLElement).style.height = `${h + 10}px`;
          });
        }
      }
    }
  }

  window.removeEventListener('message', handleAdResize);
  window.addEventListener('message', handleAdResize);

  function initAdTracking() {
    const isLive =
      !!import.meta.env.PUBLIC_SUPABASE_URL &&
      import.meta.env.PUBLIC_SUPABASE_URL !== 'https://your-project.supabase.co';

    // Direct Ad Impression & Click Tracking
    document.querySelectorAll('[data-direct-ad-id]').forEach((adEl) => {
      const adId = adEl.getAttribute('data-direct-ad-id');
      if (!adId) return;

      // Track Impression once per session
      const impKey = `thanaya_ad_imp_${adId}`;
      if (typeof window !== 'undefined' && !sessionStorage.getItem(impKey)) {
        sessionStorage.setItem(impKey, '1');
        if (isLive) {
          (supabase.rpc as any)('increment_ad_impressions', { p_ad_id: adId }).catch(() => {});
        }
      }

      // Track Click
      adEl.addEventListener('click', () => {
        if (isLive) {
          (supabase.rpc as any)('increment_ad_clicks', { p_ad_id: adId }).catch(() => {});
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initAdTracking);
</script>



