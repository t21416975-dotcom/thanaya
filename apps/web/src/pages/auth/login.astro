---
import Layout from '../../layouts/Layout.astro';
import { getStudentSession } from '../../lib/auth-server';

// هذه الصفحة تعتمد على الجلسة → يجب أن تكون SSR دائمًا
export const prerender = false;

/**
 * نصوص الأخطاء — مصدر واحد للحقيقة.
 * ترسلها /auth/callback و /api/auth/google كـ ?error=<رمز> فقط.
 * أي رمز غير معروف يسقط على `unknown` عمدًا: لا نعرض نصًا من الـ URL.
 */
const ERROR_MESSAGES: Record<string, string> = {
  access_denied: 'ألغيت عملية تسجيل الدخول. لم يُنفَّذ شيء.',
  server_error: 'واجه Google خطأً مؤقتًا. حاول مرة أخرى بعد قليل.',
  temporarily_unavailable: 'خدمة Google غير متاحة مؤقتًا. حاول بعد قليل.',
  oauth_failed: 'تعذّر بدء تسجيل الدخول عبر Google. حاول مرة أخرى.',
  callback_failed: 'لم نتمكن من تأكيد جلستك. حاول تسجيل الدخول من جديد.',
  code_exchange_failed:
    'انتهت صلاحية رابط تسجيل الدخول أو استُخدم مرتين. ابدأ تسجيل الدخول من جديد.',
  bootstrap_failed:
    'سجّلنا دخولك بنجاح لكن تعذّر تجهيز ملفك. اضغط «إعادة المحاولة» — إن تكرر الخطأ تواصل معنا.',
  account_disabled: 'حسابك معطّل. يرجى التواصل مع إدارة المنصة.',
  not_configured: 'تسجيل الدخول غير مُفعّل على هذا الخادم بعد.',
  unknown: 'حدث خطأ غير متوقع. حاول مرة أخرى.',
};

const session = await getStudentSession(Astro);

// ★ نقرأ رمز الخطأ قبل أي إعادة توجيه.
//   الصفحة كانت تتجاهل error و message تمامًا، فكان فشل /auth/callback
//   صامتًا: لا رسالة ولا سبب — كل ما يراه الطالب هو زر Google مجددًا.
// ★ لا نعرض قيمة message من الـ URL: نُثبّت النصوص هنا. عرض نص يجيء من
//   عنوان URL يسمح لأي شخص ببناء رابط يحمل رسالة مزعومة على نطاقنا.
const errorCode = Astro.url.searchParams.get('error');
// ★ لا خطأ يُعرض بلا ?error: المفتاح '' غير موجود في الخريطة، فلو تُرك
//   ??-fallback بلا شرط لظهر «خطأ غير متوقع» على كل زيارة سليمة.
const errorText = errorCode ? (ERROR_MESSAGES[errorCode] ?? ERROR_MESSAGES.unknown) : '';

// ★ returnTo يُقصَّى على مسار داخلي فقط — منع إعادة التوجيه لموقع خارجي
const rawReturnTo = Astro.url.searchParams.get('returnTo') || '/';
const returnTo =
  rawReturnTo.startsWith('/') && !rawReturnTo.startsWith('//') && !rawReturnTo.includes('\\')
    ? rawReturnTo
    : '/';

// مسجّل الدخول بالفعل؟
//   - عنده صف طالب            → إلى returnTo
//   - بلا صف ولا خطأ معروض    → محاولة واحدة لإنشاء الملف
//   - بلا صف ومع خطأ معروض   → لا تعِد التوجيه إطلاقًا.
//     ★ هذا الشرط هو ما كان ينقص: عند فشل bootstrap_student كانت
//       /auth/login → /auth/callback → /auth/login → … حلقة إعادة توجيه
//       لا نهائية (ERR_TOO_MANY_REDIRECTS). الآن أول فشل يُنهي السلسلة
//       ويعرض السبب، وتجد المستخدم زر إعادة المحاولة.
if (session.isSignedIn && (session.student || !errorCode)) {
  return Astro.redirect(session.student ? returnTo : '/auth/callback?needs=profile', 302);
}

const isConfigured = session.isConfigured;
// جلسة صالحة لكن بلا صف طالب: نعالجها هنا بدل الطرد إلى callback
const needsProfile = session.isSignedIn && !session.student;
---

<Layout
  title="تسجيل الدخول | منصة ثنايا"
  description="سجّل دخولك بحساب Google لحفظ نتائج امتحاناتك وومتابعة أخطاءك. — منصة ثنايا"
>
  <section class="mx-auto max-w-md px-4 py-12 sm:py-20">
    <div class="rounded-2xl border border-slate-200 bg-white p-8 shadow-sm">
      <div class="mb-8 text-center">
        <div
          class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-600 text-2xl font-bold text-white"
          aria-hidden="true"
        >
          ث
        </div>
        <h1 class="text-2xl font-bold text-slate-900">
          {needsProfile ? 'ملفك غير جاهز' : 'تسجيل دخول الطالب'}
        </h1>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">
          {
            needsProfile
              ? 'سجّلنا دخولك بنجاح، لكن لم نتمكن من تجهيز ملفك بعد. جرّب مرة أخرى.'
              : 'سجّل دخولك لحفظ نتائج امتحاناتك، ومتابعة الأسئلة التي أخطأت فيها، وإنشاء "امتحان أخطائك" في أي مادة.'
          }
        </p>
      </div>

      {
        errorText && (
          <div
            class="mb-6 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-900"
            role="alert"
          >
            <p class="font-semibold">تعذّر تسجيل الدخول</p>
            <p class="mt-1 leading-relaxed">{errorText}</p>
          </div>
        )
      }

      {
        !isConfigured ? (
          <div class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
            <p class="font-semibold">تسجيل الدخول غير مُفعّل بعد</p>
            <p class="mt-1 leading-relaxed">
              لم يتم ضبط مفاتيح Supabase في بيئة الموقع. أضف
              <code class="rounded bg-amber-100 px-1 py-0.5 text-xs">PUBLIC_SUPABASE_URL</code>
              و
              <code class="rounded bg-amber-100 px-1 py-0.5 text-xs">PUBLIC_SUPABASE_ANON_KEY</code>
              ثم أعد تشغيل الخادم.
            </p>
            <a href="/" class="mt-3 inline-block font-medium text-emerald-700 underline">
              العودة للرئيسية
            </a>
          </div>
        ) : needsProfile ? (
          <div class="space-y-3">
            {/* تنقّل كامل أيضًا: /auth/callback يضبط كوكي الجلسة ثم يعيد التوجيه */}
            <a
              href={`/auth/callback?needs=profile&returnTo=${encodeURIComponent(returnTo)}`}
              data-astro-reload
              class="flex w-full items-center justify-center gap-2 rounded-xl bg-emerald-600 px-5 py-3.5 font-semibold text-white transition hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2"
            >
              إعادة المحاولة
            </a>
            <form method="post" action="/api/auth/google" class="w-full">
              <button
                type="submit"
                class="w-full rounded-xl border border-slate-300 bg-white px-5 py-3 font-semibold text-slate-700 transition hover:bg-slate-50"
              >
                تسجيل الخروج والمحاولة بحساب آخر
              </button>
            </form>
          </div>
        ) : (
          <div>
            {/* ★ data-astro-reload إجباري: بدونه يعترض ClientRouter الرابط
               (نفس الأصل) ويجلبه بـ fetch بدل تنقّل حقيقي. النتيجة: المتصفح
               يطلب شاشات Google عبر XHR فيرجع 403 ERR_BLOCKED_BY_CLIENT +
               CORS، ويبقى الطالب على صفحة الدخول. data-astro-reload يُخرج
               الرابط من نطاق الـ router فتصير الرحلة تنقّلًا كاملًا. */}
            <a
              href={`/api/auth/google?returnTo=${encodeURIComponent(returnTo)}`}
              data-astro-reload
              class="flex w-full items-center justify-center gap-3 rounded-xl border border-slate-300 bg-white px-5 py-3.5 font-semibold text-slate-800 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2"
            >
              <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0" aria-hidden="true">
                <path
                  fill="#4285F4"
                  d="M23.49 12.27c0-.79-.07-1.54-.2-2.27H12v4.51h6.45a5.52 5.52 0 0 1-2.4 3.62v3h3.87c2.27-2.09 3.57-5.17 3.57-8.86Z"
                />
                <path
                  fill="#34A853"
                  d="M12 24c3.24 0 5.96-1.08 7.94-2.91l-3.87-3c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96H1.28v3.09A12 12 0 0 0 12 24Z"
                />
                <path
                  fill="#FBBC05"
                  d="M5.27 14.29a7.2 7.2 0 0 1 0-4.58V6.62H1.28a12 12 0 0 0 0 10.76l3.99-3.09Z"
                />
                <path
                  fill="#EA4335"
                  d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.44-3.44C17.95 1.19 15.24 0 12 0A12 12 0 0 0 1.28 6.62l3.99 3.09C6.22 6.86 8.87 4.75 12 4.75Z"
                />
              </svg>
              المتابعة باستخدام حساب Google
            </a>

            <p class="mt-4 text-center text-xs leading-relaxed text-slate-500">
              بالمتابعة أنت توافق على
              <a href="/terms" class="underline">الشروط والأحكام</a>
              و<a href="/privacy" class="underline">سياسة الخصوصية</a>.
            </p>
          </div>
        )
      }

      <div class="mt-8 border-t border-slate-100 pt-6">
        <p class="text-center text-sm text-slate-500">
          هل تريد حل امتحان دون تسجيل دخول؟
          <a href="/exams" class="font-medium text-emerald-700 underline">تصفّح الامتحانات</a>
        </p>
        <p class="mt-2 text-center text-xs leading-relaxed text-slate-400">
          يمكنك تجربة الامتحان كزائر، لكن النتيجة لن تُحفظ ولا يمكنك إنشاء
          "امتحان أخطائك".
        </p>
      </div>
    </div>
  </section>
</Layout>
