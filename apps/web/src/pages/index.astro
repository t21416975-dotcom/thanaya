---
import Layout from '../layouts/Layout.astro';
import SubjectCard from '../components/SubjectCard.astro';
import ResourceCard from '../components/ResourceCard.astro';
import AdSlot from '../components/AdSlot.astro';
import { publicApi } from '../lib/api';
import { buildPageSchema } from '../lib/geo';

const subjects = await publicApi.getActiveSubjects();
const latestAssessments = await publicApi.getPublishedResources({ limit: 6 });
const jsonLd = buildPageSchema({ pageType: 'home', resources: latestAssessments });

// Lightweight client-side search index: subjects + latest published resources
const searchableResources = await publicApi.getPublishedResources({ limit: 60 });
const searchIndex = [
  ...subjects.map((s) => ({
    type: 'subject',
    title: s.name,
    url: `/subjects/${s.slug}`,
    meta: 'مادة دراسية',
  })),
  ...searchableResources
    .filter((r) => r.is_published)
    .map((r) => ({
      type: 'resource',
      title: r.title,
      url: `/resources/${r.slug}`,
      meta: [r.subject?.name, r.content_type?.name, r.week?.title].filter(Boolean).join('، '),
    })),
];
const searchIndexJson = JSON.stringify(searchIndex).replace(/</g, '\\u003c');
---

<Layout
  title="منصة ثنايا | التقييمات والحلول والمذكرات للبكالوريا المصرية"
  jsonLd={jsonLd}
>
  <div class="space-y-10">
    {/* Hero Section with Instant Search */}
    <section class="text-center py-10 bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm">
      <div class="inline-flex items-center gap-2 bg-emerald-50 text-emerald-800 text-xs px-3.5 py-1.5 rounded-full font-bold mb-4 border border-emerald-100 shadow-sm">
        <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
          <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
        </svg>
        <span>دفعة تانية بكالوريا</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-slate-900">
        التقييمات كلها في مكان واحد
      </h1>
      <p class="mt-3 text-sm sm:text-base text-slate-600 max-w-2xl mx-auto leading-relaxed">
        تصفح وتحميل مباشر وسريع للتقييمات الأسبوعية، نماذج الإجابة، الامتحانات التجريبية، والمذكرات
        بدون إعلانات مزعجة وبأعلى سرعة ممكنة.
      </p>

      {/* Instant client-side search */}
      <div class="relative max-w-xl mx-auto mt-6 text-right" id="home-search">
        <label for="home-search-input" class="sr-only">ابحث عن تقييم أو حل أو مذكرة</label>
        <div class="relative">
          <svg class="w-5 h-5 text-slate-400 absolute right-3.5 top-1/2 -translate-y-1/2 pointer-events-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            id="home-search-input"
            type="search"
            autocomplete="off"
            role="combobox"
            aria-expanded="false"
            aria-controls="home-search-results"
            placeholder="ابحث عن تقييم، حل، مذكرة، أو مادة…"
            class="w-full rounded-2xl border border-slate-300 bg-slate-50 pr-11 pl-4 py-3.5 text-sm text-slate-900 placeholder:text-slate-400 focus:border-emerald-500 focus:bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500/30 transition"
          />
        </div>
        <div
          id="home-search-results"
          role="listbox"
          aria-label="نتائج البحث"
          class="hidden absolute z-30 mt-2 w-full max-h-80 overflow-y-auto rounded-2xl border border-slate-200 bg-white shadow-lg divide-y divide-slate-100 text-right"
        ></div>
        <p class="mt-2 text-[11px] text-slate-500">مثال: «تقييم الأسبوع الرابع» أو اسم المادة — والبحث يتغاضى عن الأخطاء الإملائية</p>
      </div>

      <script is:inline type="application/json" id="home-search-data" set:html={searchIndexJson}></script>
    </section>

    {/* Top Ad Slot */}
    <AdSlot position="homepage_top" />

    {/* Subjects Section */}
    <section id="subjects" class="space-y-4 scroll-mt-24">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-xl font-bold text-slate-900">المواد الدراسية</h2>
          <p class="text-xs text-slate-500">اختر المادة لتصفح تقييماتها ومذكراتها مرتبة بالأسابيع</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {subjects.map((subj) => (
          <SubjectCard subject={subj} />
        ))}
      </div>
    </section>

    {/* Middle Ad Slot */}
    <AdSlot position="homepage_middle" />

    {/* Latest Resources Section */}
    <section class="space-y-4">
      <div>
        <h2 class="text-xl font-bold text-slate-900">أحدث التقييمات والموارد المضافة</h2>
        <p class="text-xs text-slate-500">وصول مباشر لأحدث الملفات المرفوعة على المنصة</p>
      </div>

      <div class="space-y-3">
        {latestAssessments.map((res) => (
          <ResourceCard resource={res} />
        ))}
        {latestAssessments.length === 0 && (
          <div class="bg-white rounded-xl border border-slate-200 p-8 text-center text-slate-500">
            جاري إضافة الموارد والتقييمات قريبًا.
          </div>
        )}
      </div>
    </section>
  </div>

  {/* Fuzzy instant search: typo-tolerant Arabic matching with ranked results */}
  <script is:inline>
    (function () {
      const dataEl = document.getElementById('home-search-data');
      const input = document.getElementById('home-search-input');
      const resultsEl = document.getElementById('home-search-results');
      if (!dataEl || !input || !resultsEl) return;

      let index = [];
      try {
        index = JSON.parse(dataEl.textContent || '[]');
      } catch (e) {
        index = [];
      }

      let matches = [];
      let activeIdx = -1;
      let debounceTimer = null;

      // Deep Arabic normalization: strip tashkeel/tatweel/shadda, unify hamza/alef/waw/ya/taa forms
      function normalize(str) {
        return (str || '')
          .toString()
          .toLowerCase()
          .replace(/[ً-ْـّ]/g, '')
          .replace(/[أإآٱ]/g, 'ا')
          .replace(/ؤ/g, 'و')
          .replace(/ئ/g, 'ي')
          .replace(/ء/g, '')
          .replace(/ة/g, 'ه')
          .replace(/ى/g, 'ي');
      }

      // Drop the definite article for fairer comparison (الفيزياء == فيزياء)
      function stemToken(t) {
        return t.length > 3 && t.indexOf('ال') === 0 ? t.slice(2) : t;
      }

      // Damerau-Levenshtein distance: tolerates missing/extra/swapped/substituted letters
      function editDistance(a, b) {
        if (a === b) return 0;
        const la = a.length;
        const lb = b.length;
        if (!la) return lb;
        if (!lb) return la;
        const dp = [];
        for (let i = 0; i <= la; i++) dp.push([i]);
        for (let j = 0; j <= lb; j++) dp[0][j] = j;
        for (let i = 1; i <= la; i++) {
          for (let j = 1; j <= lb; j++) {
            const cost = a.charAt(i - 1) === b.charAt(j - 1) ? 0 : 1;
            dp[i][j] = Math.min(dp[i - 1][j] + 1, dp[i][j - 1] + 1, dp[i - 1][j - 1] + cost);
            if (i > 1 && j > 1 && a.charAt(i - 1) === b.charAt(j - 2) && a.charAt(i - 2) === b.charAt(j - 1)) {
              dp[i][j] = Math.min(dp[i][j], dp[i - 2][j - 2] + cost);
            }
          }
        }
        return dp[la][lb];
      }

      function allowedErrors(token) {
        if (token.length >= 7) return 2;
        if (token.length >= 4) return 1;
        return 0;
      }

      // Score an item against query tokens; -1 = not a match. Every query token must match something.
      function scoreItem(item, qTokens) {
        const hay = normalize(item.title + ' ' + (item.meta || ''));
        const hayTokens = hay.split(/\s+/).filter(Boolean);
        let total = 0;
        for (let qi = 0; qi < qTokens.length; qi++) {
          const q = stemToken(qTokens[qi]);
          if (!q) continue;
          let best = -1;
          if (hay.indexOf(q) !== -1) {
            best = 100; // exact substring
          } else {
            for (let hi = 0; hi < hayTokens.length; hi++) {
              const h = stemToken(hayTokens[hi]);
              if (!h) continue;
              if (h.indexOf(q) === 0 || q.indexOf(h) === 0) {
                best = Math.max(best, 80); // prefix match
                continue;
              }
              const d = editDistance(q, h);
              if (d <= allowedErrors(q)) best = Math.max(best, 60 - d * 10); // fuzzy typo match
            }
          }
          if (best < 0) return -1;
          total += best;
        }
        return total;
      }


      function escapeHtml(s) {
        return String(s)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      function closeResults() {
        resultsEl.classList.add('hidden');
        input.setAttribute('aria-expanded', 'false');
        activeIdx = -1;
      }

      function render() {
        if (matches.length === 0) {
          resultsEl.innerHTML =
            '<div class="px-4 py-6 text-center text-xs text-slate-500">لا توجد نتائج مطابقة — جرّب اسم المادة أو عنوان الملف.</div>';
        } else {
          resultsEl.innerHTML = matches
            .map(function (item, i) {
              const badge =
                item.type === 'subject'
                  ? '<span class="shrink-0 text-[10px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-100 px-2 py-0.5 rounded-full">مادة</span>'
                  : '<span class="shrink-0 text-[10px] font-bold text-slate-600 bg-slate-100 px-2 py-0.5 rounded-full">ملف</span>';
              return (
                '<a href="' +
                item.url +
                '" role="option" aria-selected="' +
                (i === activeIdx) +
                '" class="flex items-center gap-3 px-4 py-3 transition ' +
                (i === activeIdx ? 'bg-emerald-50/70' : 'hover:bg-slate-50') +
                '">' +
                badge +
                '<span class="flex-1 min-w-0">' +
                '<span class="block text-sm font-semibold text-slate-900 truncate">' +
                escapeHtml(item.title) +
                '</span>' +
                (item.meta
                  ? '<span class="block text-[11px] text-slate-500 truncate mt-0.5">' + escapeHtml(item.meta) + '</span>'
                  : '') +
                '</span></a>'
              );
            })
            .join('');
        }
        resultsEl.classList.remove('hidden');
        input.setAttribute('aria-expanded', 'true');
      }

      function runSearch() {
        const qRaw = normalize(input.value.trim());
        if (qRaw.length < 2) {
          closeResults();
          return;
        }
        const qTokens = qRaw.split(/\s+/).filter(Boolean);
        matches = index
          .map(function (item) {
            return { item: item, score: scoreItem(item, qTokens) };
          })
          .filter(function (r) {
            return r.score > 0;
          })
          .sort(function (a, b) {
            return b.score - a.score;
          })
          .slice(0, 8)
          .map(function (r) {
            return r.item;
          });
        activeIdx = matches.length ? 0 : -1;
        render();
      }

      input.addEventListener('input', function () {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(runSearch, 120);
      });

      input.addEventListener('focus', function () {
        if (input.value.trim().length >= 2) runSearch();
      });

      input.addEventListener('keydown', function (e) {
        if (resultsEl.classList.contains('hidden')) return;
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          e.preventDefault();
          if (!matches.length) return;
          activeIdx =
            e.key === 'ArrowDown' ? (activeIdx + 1) % matches.length : (activeIdx - 1 + matches.length) % matches.length;
          render();
        } else if (e.key === 'Enter') {
          if (activeIdx >= 0 && matches[activeIdx]) {
            e.preventDefault();
            window.location.href = matches[activeIdx].url;
          }
        } else if (e.key === 'Escape') {
          closeResults();
        }
      });

      // One-time delegated outside-click closer (survives ClientRouter swaps)
      if (!window.__thanayaSearchCloserBound) {
        window.__thanayaSearchCloserBound = true;
        document.addEventListener('click', function (e) {
          const r = document.getElementById('home-search-results');
          const i = document.getElementById('home-search-input');
          if (r && i && !r.contains(e.target) && e.target !== i) {
            r.classList.add('hidden');
            i.setAttribute('aria-expanded', 'false');
          }
        });
      }
    })();
  </script>
</Layout>
