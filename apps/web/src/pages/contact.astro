---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="اتصل بنا | منصة ثنايا"
  description="تواصل مع فريق منصة ثنايا — نسعد بردودكم واستفساراتكم واقتراحاتكم."
>
  <div class="max-w-2xl mx-auto space-y-8">

    <!-- Header -->
    <div class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-10 shadow-sm">
      <div class="flex items-center gap-4 mb-6">
        <span class="w-12 h-12 rounded-xl bg-gradient-to-tr from-emerald-600 to-teal-500 text-white flex items-center justify-center flex-shrink-0 shadow-sm">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
        </span>
        <div>
          <h1 class="text-2xl font-extrabold text-slate-900">اتصل بنا</h1>
          <p class="text-sm text-slate-500 mt-0.5">نرد عادةً خلال 24-48 ساعة</p>
        </div>
      </div>

      <!-- Quick contact options -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
        <a
          href="mailto:contact@thanaya.com"
          class="flex items-center gap-3 p-4 bg-emerald-50 hover:bg-emerald-100 border border-emerald-100 rounded-xl transition group"
        >
          <span class="w-9 h-9 rounded-lg bg-emerald-600 text-white flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          </span>
          <div>
            <p class="text-xs text-slate-500 font-medium">البريد الإلكتروني</p>
            <p class="text-sm font-bold text-emerald-700 group-hover:text-emerald-800 dir-ltr">contact@thanaya.com</p>
          </div>
        </a>
        <div class="flex items-center gap-3 p-4 bg-slate-50 border border-slate-100 rounded-xl">
          <span class="w-9 h-9 rounded-lg bg-slate-300 text-white flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          </span>
          <div>
            <p class="text-xs text-slate-500 font-medium">وقت الرد</p>
            <p class="text-sm font-bold text-slate-700">خلال 24 – 48 ساعة</p>
          </div>
        </div>
      </div>

      <!-- Form -->
      <form
        method="POST"
        action="mailto:contact@thanaya.com"
        enctype="text/plain"
        class="space-y-5"
        id="contact-form"
      >
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          <div>
            <label for="contact-name" class="block text-xs font-semibold text-slate-700 mb-1.5">الاسم *</label>
            <input
              type="text"
              id="contact-name"
              name="الاسم"
              required
              placeholder="اسمك الكريم"
              class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition"
            />
          </div>
          <div>
            <label for="contact-email" class="block text-xs font-semibold text-slate-700 mb-1.5">البريد الإلكتروني *</label>
            <input
              type="email"
              id="contact-email"
              name="البريد"
              required
              placeholder="omar280sayed@gmail.com"
              dir="ltr"
              class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition"
            />
          </div>
        </div>

        <div>
          <label for="contact-subject" class="block text-xs font-semibold text-slate-700 mb-1.5">الموضوع *</label>
          <select
            id="contact-subject"
            name="الموضوع"
            required
            class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm text-slate-800 bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition"
          >
            <option value="">— اختر موضوع الرسالة —</option>
            <option value="اقتراح">اقتراح أو فكرة لتطوير المنصة</option>
            <option value="بلاغ_محتوى">الإبلاغ عن محتوى خاطئ أو مفقود</option>
            <option value="إعلان">الاستفسار عن الإعلان أو الرعاية</option>
            <option value="شراكة">طلب شراكة أو تعاون</option>
            <option value="أخرى">أخرى</option>
          </select>
        </div>

        <div>
          <label for="contact-message" class="block text-xs font-semibold text-slate-700 mb-1.5">الرسالة *</label>
          <textarea
            id="contact-message"
            name="الرسالة"
            rows={5}
            required
            placeholder="اكتب رسالتك هنا..."
            class="w-full px-3.5 py-2.5 border border-slate-300 rounded-xl text-sm text-slate-800 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 transition resize-y"
          ></textarea>
        </div>

        <!-- Hidden fields for context -->
        <div id="form-status" class="hidden text-xs p-3 rounded-xl"></div>

        <div class="flex items-center justify-between gap-4 flex-wrap">
          <p class="text-xs text-slate-400">* جميع الحقول المُعلّمة إلزامية</p>
          <button
            type="submit"
            id="contact-submit"
            class="inline-flex items-center gap-2 px-6 py-3 bg-emerald-600 hover:bg-emerald-700 active:scale-[0.98] text-white font-bold text-sm rounded-xl transition shadow-sm"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
            إرسال الرسالة
          </button>
        </div>
      </form>
    </div>

    <!-- Note -->
    <div class="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm">
      <h2 class="text-base font-bold text-slate-800 mb-3 border-r-4 border-emerald-500 pr-3">ملاحظة</h2>
      <p class="text-sm text-slate-600 leading-loose">
        للإبلاغ عن مشكلة في ملف أو تقييم بعينه، يُفضل استخدام زر <strong class="text-slate-800">"الإبلاغ عن مشكلة"</strong> الموجود في كل صفحة مورد مباشرةً، لأن ذلك يُوصل البلاغ أسرع لفريق المراجعة.
      </p>
    </div>

  </div>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('form-status');
  const submitBtn = document.getElementById('contact-submit') as HTMLButtonElement | null;

  form?.addEventListener('submit', () => {
    // Let mailto: handle it but show a thank-you message
    setTimeout(() => {
      if (statusEl) {
        statusEl.className = 'text-xs p-3 rounded-xl bg-emerald-50 text-emerald-800 border border-emerald-200 block';
        statusEl.textContent = '✓ تم فتح عميل البريد الإلكتروني. شكرًا لتواصلك معنا!';
      }
      if (submitBtn) {
        submitBtn.textContent = '✓ تم الإرسال';
        submitBtn.disabled = true;
      }
    }, 300);
  });
</script>
